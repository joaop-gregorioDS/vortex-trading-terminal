# Build and run the Next.js frontend in standalone mode.
# ADR-001 keeps the frontend a separate deployable from the API; Nginx joins them at one origin.

FROM node:24-bookworm-slim AS build
WORKDIR /app

# package.json and the lockfile first, so npm ci is cached independently of source changes.
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web/ ./

# The page fetches the API at request time behind connection(), and next.config.ts enables
# standalone output, so the build needs no API and no secrets.
RUN npm run build

FROM node:24-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Run as the unprivileged "node" user that the official image already provides.
USER node

# The standalone bundle carries its own server and only the dependencies it actually uses.
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public

EXPOSE 3000

CMD ["node", "server.js"]
