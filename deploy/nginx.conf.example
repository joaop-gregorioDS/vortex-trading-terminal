# Nginx server block for vortexsoftware.tech.
#
# Copy into the host Nginx configuration (for example /etc/nginx/sites-available/vortexsoftware.tech),
# adjust server_name, then:
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d vortexsoftware.tech
#
# The API is proxied under /api so the browser sees one origin for the page and the API. That removes
# any need for CORS and keeps the containers on loopback.

server {
    listen 80;
    listen [::]:80;
    server_name vortexsoftware.tech;

    # Everything below stays reachable over HTTP only long enough for certbot to issue a
    # certificate; certbot rewrites this block to redirect to HTTPS.

    # Buffers and timeouts are sized for small JSON requests, not uploads.
    client_max_body_size 1m;

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location /health/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
