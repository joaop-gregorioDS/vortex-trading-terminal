# Production composition for the Vortex Trading Terminal VPS.
# Copy to .env, fill every value with a real secret, and never commit the result.
#
# Generate the database password with: openssl rand -hex 32

# PostgreSQL (required)
POSTGRES_PASSWORD=replace-with-random-hex

# Host loopback ports. Nginx is the only thing that should face the internet, so both stay
# bound to 127.0.0.1 and the reverse proxy forwards to them.
API_PORT=8080
WEB_PORT=3000
