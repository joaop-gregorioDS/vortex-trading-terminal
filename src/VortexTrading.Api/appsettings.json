{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VortexTrading": {
    "ApplicationName": "Vortex Trading Terminal",
    "Risk": {
      "Enabled": true,
      "MaxOrderQuantity": 1000.0,
      "MaxOrderNotional": 50000.0,
      "MaxPositionQuantity": 2000.0,
      "RequireReferencePriceForMarketOrders": true
    }
  }
}
